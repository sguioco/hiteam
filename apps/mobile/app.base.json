{
  "expo": {
    "name": "HiTeam",
    "slug": "smart",
    "scheme": "hiteam",
    "description": "HiTeam helps companies manage shifts, tasks, attendance, news, and employee performance in one mobile workspace.",
    "version": "5.0.8",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "net.hiteam.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Smart uses the front camera to verify your identity before you can enter the workspace.",
        "NSLocationWhenInUseUsageDescription": "Smart uses your precise location to confirm that you are inside the approved work area when starting or ending a shift.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.HiTeam",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Smart uses the front camera to verify your identity before you can enter the workspace."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Smart uses the camera so you can capture photos during onboarding and work tasks.",
          "photosPermission": "Smart needs access to your photo library so you can attach images during onboarding and work tasks."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart uses your precise location to confirm that you are inside the approved work area when starting or ending a shift."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ru", "en", "es", "ar", "hi", "ur", "bn", "id", "ms", "tl"],
            "android": [
              "ru",
              "en",
              "es",
              "ar",
              "hi",
              "ur",
              "bn",
              "id",
              "ms",
              "tl"
            ]
          }
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "privacyPolicyUrl": "https://hiteam.net/privacy",
      "router": {},
      "eas": {
        "projectId": "35bb3b6c-af5d-410a-b463-0d3da3c0de78"
      }
    },
    "runtimeVersion": "5.0.8",
    "updates": {
      "url": "https://u.expo.dev/35bb3b6c-af5d-410a-b463-0d3da3c0de78"
    }
  }
}
