{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::{{ .Values.minio.bucket }}"]
    },
    {
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::{{ .Values.minio.bucket }}/employees/*/avatars/*",
        "arn:aws:s3:::{{ .Values.minio.bucket }}/tenants/*/announcements/*",
        "arn:aws:s3:::{{ .Values.minio.bucket }}/tenants/*/requests/*",
        "arn:aws:s3:::{{ .Values.minio.bucket }}/exports/*",
        "arn:aws:s3:::{{ .Values.minio.bucket }}/biometric/*"
      ]
    }
  ]
}
